# Optional. Without it the channel stats fall back to static placeholders.
# Create at https://console.cloud.google.com, enable "YouTube Data API v3".
YOUTUBE_API_KEY=
# Optional override. Defaults to the @elpideus handle lookup.
YOUTUBE_CHANNEL_ID=

# Contact form delivery. Without it the form reports a friendly failure.
RESEND_API_KEY=
CONTACT_TO_EMAIL=elpideus@gmail.com

# Optional. Without them the GitHub now playing card shows its "off air" state.
# Key: https://www.last.fm/api/account/create (only the API key is used, never the secret).
# Spotify has to be connected under Last.fm settings, Applications.
LASTFM_API_KEY=
LASTFM_USERNAME=
